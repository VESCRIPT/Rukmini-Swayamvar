<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Angular SPA: serve index.html for client routes -->
        <rule name="Angular Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/uploads" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/matrimony" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
        <!-- Proxy API to backend (requires IIS URL Rewrite + Application Request Routing) -->
        <rule name="Proxy API" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="https://vescript.vescript.com/api/{R:1}" />
        </rule>
        <rule name="Proxy Uploads" stopProcessing="true">
          <match url="^uploads/(.*)" />
          <action type="Rewrite" url="https://vescript.vescript.com/uploads/{R:1}" />
        </rule>
        <rule name="Proxy Matrimony" stopProcessing="true">
          <match url="^matrimony/(.*)" />
          <action type="Rewrite" url="https://vescript.vescript.com/matrimony/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
